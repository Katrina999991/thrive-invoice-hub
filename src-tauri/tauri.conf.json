{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GestionFlow",
  "version": "0.1.1",
  "identifier": "ca.statis.gestionflow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GestionFlow",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "LicenseRef-proprietary",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/GestionFlow.desktop",
        "files": {
          "/usr/share/metainfo/ca.statis.GestionFlow.metainfo.xml": "linux/ca.statis.GestionFlow.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/GestionFlow.desktop",
        "postInstallScript": "linux/rpm-postinstall.sh",
        "provides": ["gestionflow"],
        "files": {
          "/usr/share/metainfo/ca.statis.GestionFlow.metainfo.xml": "linux/ca.statis.GestionFlow.metainfo.xml",
          "/etc/yum.repos.d/gestionflow.repo": "../public/rpm/gestionflow.repo",
          "/etc/pki/rpm-gpg/RPM-GPG-KEY-gestionflow": "../public/rpm/RPM-GPG-KEY-gestionflow"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
